{
  "type": "object",
  "properties": {
    "greeting": {
      "type": "string",
      "title": "Greeting",
      "description": "The word that starts every greeting.",
      "default": "Hello",
      "minLength": 1
    },
    "shout": {
      "type": "boolean",
      "title": "Shout",
      "description": "Make greetings upper case.",
      "default": false
    },
    "repeat": {
      "type": "integer",
      "title": "Repeat",
      "description": "How many times the greeting is said.",
      "default": 1,
      "minimum": 1,
      "maximum": 5
    },
    "mood": {
      "type": "string",
      "title": "Mood",
      "enum": ["calm", "casual", "formal", "silly", "loud"],
      "default": "casual",
      "x-frosty-group": "Style"
    },
    "accent": {
      "type": "string",
      "title": "Accent color",
      "format": "color",
      "default": "#f5913a",
      "x-frosty-group": "Style"
    },
    "nicknames": {
      "type": "array",
      "title": "Nicknames",
      "description": "Greeted by these as well.",
      "items": { "type": "string" },
      "default": [],
      "x-frosty-group": "People"
    }
  },
  "additionalProperties": false
}
