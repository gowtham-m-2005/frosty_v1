{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spike-capability",
  "version": "0.0.0",
  "identifier": "dev.frosty.spike-capability",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' http://frosty-cap.localhost; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
